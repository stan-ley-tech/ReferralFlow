DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMATTER=verbose

DATABASE_URL=postgres://referralflow:referralflow@localhost:5432/referralflow
DATABASE_CONN_MAX_AGE=60

REDIS_CACHE_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:3000

REFERRAL_DEFAULT_EXPIRY_HOURS=72
REFERRAL_URGENT_EXPIRY_HOURS=24
REFERRAL_EMERGENCY_EXPIRY_HOURS=6

EXTERNAL_HOSPITAL_BASE_URL=http://localhost:8000/api/v1/integrations/simulated-hospital
EXTERNAL_HOSPITAL_TIMEOUT_SECONDS=10
EXTERNAL_HOSPITAL_MAX_RETRIES=3
EXTERNAL_HOSPITAL_WEBHOOK_SECRET=dev-webhook-secret
